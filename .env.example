# ─── Supabase ───────────────────────────────────────────────
# Create a project at https://supabase.com, then grab these from
# Settings → API. Leave blank to run in demo mode (mock data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Web research: Tavily (required) ────────────────────────
# Real-time research for the Search page and price refreshes.
# Free "Researcher" plan: 1,000 credits a month, no credit card.
# Get a key at https://app.tavily.com — then keep it ONLY here.
#
# $0 guarantee: the app refuses any call that would take the month past
# TAVILY_MONTHLY_CREDIT_CAP, before the request is sent. Over the free
# limit, Tavily itself refuses with 432 unless pay-as-you-go is enabled —
# keep pay-as-you-go OFF in the Tavily dashboard.
TAVILY_API_KEY=

# Most credits the app will spend per month. Default 950 (of 1,000 free),
# leaving room for anything run outside the app. Never raise this above
# your plan unless you have deliberately moved to a paid plan.
TAVILY_MONTHLY_CREDIT_CAP=950

# basic = 1 credit (default, recommended). advanced = 2 credits.
TAVILY_SEARCH_DEPTH=basic

# Full page text in the same call — how one search yields price AND specs.
TAVILY_INCLUDE_RAW_CONTENT=true

# Per-request timeout (ms), and how long an answer is reused for free.
TAVILY_TIMEOUT_MS=15000
TAVILY_CACHE_TTL_MINUTES=360

# Scheduled price checks never spend below this many remaining credits
# (kept for people doing research), and never more than this per run.
CRON_CREDIT_RESERVE=200
CRON_MAX_CREDITS_PER_RUN=25

# ─── Resend (email reports) ────────────────────────────────
# Sign up at https://resend.com — free tier gives 100 emails/day.
RESEND_API_KEY=
REPORT_FROM_EMAIL=LuggageTracker <reports@yourdomain.com>
REPORT_TO_EMAIL=yycluggagedepot@gmail.com

# ─── Cron protection ───────────────────────────────────────
# Random string to protect cron API endpoints from public access.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# ─── Google Gemini AI ───────────────────────────────────────
# Free API key from https://aistudio.google.com/apikey
# Used to interpret search queries, group listings into products, and
# power the chat assistant. It NEVER produces a price.
GEMINI_API_KEY=

# Optional. Leave unset — the app tries current Flash models in order
# and caches the first that works, so a Google retirement can't break it.
GEMINI_MODEL=

# How long a search result stays cached. Repeating a cached search
# costs no provider quota. Default 360 (6 hours).
SEARCH_CACHE_TTL_MINUTES=360

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
