# ─── Supabase ───────────────────────────────────────────────
# Create a project at https://supabase.com, then grab these from
# Settings → API. Leave blank to run in demo mode (mock data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Price providers (you need at least one) ────────────────
# Both are free and neither asks for a credit card. The app uses
# whichever is configured, preferring Serper for its larger allowance.

# Serper.dev — 2,500 free searches, one-time. https://serper.dev
SERPER_API_KEY=

# SerpAPI — 250 free searches per month, renews. https://serpapi.com
SERPAPI_KEY=

# ─── Resend (email reports) ────────────────────────────────
# Sign up at https://resend.com — free tier gives 100 emails/day.
RESEND_API_KEY=
REPORT_FROM_EMAIL=LuggageTracker <reports@yourdomain.com>
REPORT_TO_EMAIL=yycluggagedepot@gmail.com

# ─── Cron protection ───────────────────────────────────────
# Random string to protect cron API endpoints from public access.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# ─── Google Gemini AI ───────────────────────────────────────
# Free API key from https://aistudio.google.com/apikey
# Used to interpret search queries, group listings into products, and
# power the chat assistant. It NEVER produces a price.
GEMINI_API_KEY=

# Optional. Leave unset — the app tries current Flash models in order
# and caches the first that works, so a Google retirement can't break it.
GEMINI_MODEL=

# ─── Allowance guards (optional) ────────────────────────────
# Raise these if you move off a free plan. The app stops calling a
# provider once its allowance is spent rather than failing with a 429.
SERPER_CREDIT_LIMIT=2500
SERPAPI_MONTHLY_LIMIT=250

# How long a search result stays cached. Repeating a cached search
# costs no provider quota. Default 360 (6 hours).
SEARCH_CACHE_TTL_MINUTES=360

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How long to wait for SerpAPI before giving up, in ms. It scrapes Google
# live, so 15-30s is normal. Raise this if you see timeout errors.
SERPAPI_TIMEOUT_MS=25000

# Gemini Google Search grounding as a last-resort price source.
# OFF by default: it requires a BILLING-ENABLED Google project, so on a free
# key it fails every time and only muddies the error message.
ENABLE_GEMINI_GROUNDED_SEARCH=false
