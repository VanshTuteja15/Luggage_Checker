# ─── Supabase ───────────────────────────────────────────────
# Create a project at https://supabase.com, then grab these from
# Settings → API. Left blank, the app shows a "not configured" sign-in
# screen; there is no mock data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Web research: Tavily (required) ────────────────────────
# Real-time research for the Search page and price refreshes.
# Free "Researcher" plan: 1,000 credits a month, no credit card.
# Get a key at https://app.tavily.com — then keep it ONLY here.
#
# $0 guarantee: the app refuses any call that would take the month past
# TAVILY_MONTHLY_CREDIT_CAP, before the request is sent. Over the free
# limit, Tavily itself refuses with 432 unless pay-as-you-go is enabled —
# keep pay-as-you-go OFF in the Tavily dashboard.
TAVILY_API_KEY=

# Most credits the app will spend per month. Default 950 (of 1,000 free),
# leaving room for anything run outside the app. Never raise this above
# your plan unless you have deliberately moved to a paid plan.
TAVILY_MONTHLY_CREDIT_CAP=950

# basic = 1 credit (default, recommended). advanced = 2 credits.
TAVILY_SEARCH_DEPTH=basic

# Full page text in the same call — how one search yields price AND specs.
TAVILY_INCLUDE_RAW_CONTENT=true

# Per-request timeout (ms), and how long an answer is reused for free.
TAVILY_TIMEOUT_MS=15000
TAVILY_CACHE_TTL_MINUTES=360

# Scheduled price checks never spend below this many remaining credits
# (kept for people doing research), and never more than this per run.
CRON_CREDIT_RESERVE=200
CRON_MAX_CREDITS_PER_RUN=25

# ─── Resend (email reports) ────────────────────────────────
# Sign up at https://resend.com — free tier gives 100 emails/day.
RESEND_API_KEY=
REPORT_FROM_EMAIL=LuggageTracker <reports@yourdomain.com>
REPORT_TO_EMAIL=yycluggagedepot@gmail.com

# ─── Cron protection ───────────────────────────────────────
# Random string to protect cron API endpoints from public access.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# ─── Google Gemini AI ───────────────────────────────────────
# Free API key from https://aistudio.google.com/apikey
# Used to interpret search queries, group listings into products, and
# power the chat assistant. It NEVER produces a price.
GEMINI_API_KEY=

# Optional. Leave unset — the app tries current Flash models in order
# and caches the first that works, so a Google retirement can't break it.
GEMINI_MODEL=

# How long a search result stays cached. Repeating a cached search
# costs no provider quota. Default 360 (6 hours).
SEARCH_CACHE_TTL_MINUTES=360

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ════════════════════════════════════════════════════════════
#  Price engine (see docs/ARCHITECTURE.md, docs/HUMAN_ACTIONS.md)
# ════════════════════════════════════════════════════════════

# ─── Database (server and worker only, never NEXT_PUBLIC) ──
# Supabase → Settings → Database → Connection string → Session pooler.
# Gives the engine the same access as the service role: server-side only.
DATABASE_URL=
# Supabase CA certificate (PEM, \n escapes allowed). If unset, the
# certificate is checked against public roots; DATABASE_SSL=no-verify
# keeps encryption but skips the identity check (last resort).
DATABASE_SSL_CA=
DATABASE_SSL=

# ─── Worker (Vercel only orchestrates) ─────────────────────
# Public HTTPS address of the worker, e.g. https://worker.example.com.
# Unset = research runs inline in the Next.js server (dev / fallback).
WORKER_URL=
# Same value on Vercel and on the worker: openssl rand -hex 32
WORKER_SHARED_SECRET=
# Worker-only settings (PORT, WORKER_MAX_SESSIONS, LOG_LEVEL): worker/README.md.

# ─── Honest identification ─────────────────────────────────
# Email or URL store operators can reach us at. Goes in the User-Agent.
# Default: the project's public issue tracker.
CRAWLER_CONTACT=

# ─── Store channels (free) ─────────────────────────────────
# Public URL of our UCP agent profile (Shopify Catalog MCP needs it).
# Once deployed: https://<your-app>/.well-known/ucp-agent
UCP_AGENT_PROFILE_URL=
# eBay Browse API (free): developer.ebay.com → Application Keys → Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Amazon Creators API: inactive until an Associates account qualifies, and
# also gated by the adapter.amazon_creators_api flag.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_ASSOCIATE_TAG=

# ─── Engine limits (defaults shown) ────────────────────────
# Research session hard stop (10–12 s per the spec), single-flight window.
ENGINE_SESSION_DEADLINE_MS=11000
ENGINE_SINGLE_FLIGHT_MS=90000
ENGINE_FETCH_TIMEOUT_MS=8000
# Per-user research limits.
ENGINE_RATE_LIMIT_PER_WINDOW=20
ENGINE_RATE_LIMIT_WINDOW_MS=600000
ENGINE_MAX_CONCURRENT_SESSIONS=2
# Daily verification and discovery budgets (requests per run).
ENGINE_CRON_MAX_FETCHES=300
ENGINE_CRON_MAX_PRODUCTS=100
ENGINE_DISCOVERY_MAX_FETCHES_PER_STORE=150
ENGINE_DISCOVERY_MAX_SITEMAP_URLS=20000
# Operator flag overrides, e.g. "discovery.tavily=on,engine.default_search=off".
# Normally flags are flipped in /admin instead.
ENGINE_FLAGS=
