# ------------------------------------------------------------------
# deploy/oracle/env.example → copy to deploy/oracle/.env (git-ignored)
# on the VM and fill it in there. Never commit the filled file and
# never paste its values in chat. setup.sh sets it to mode 600.
# ------------------------------------------------------------------

# The app's database: Supabase → Project Settings → Database →
# Connection string, "Session pooler" (port 5432). The worker's job
# queue (pg-boss) lives there too.
DATABASE_URL=
# The same value as WORKER_SHARED_SECRET on Vercel (signs app → worker requests).
WORKER_SHARED_SECRET=
# The app's address and its cron secret (the morning email's fallback tick).
APP_URL=
CRON_SECRET=
# A monitored contact for our crawler's user agent (an email or a URL).
CRAWLER_CONTACT=

# Local AI: advice only, and every AI flag stays off until the owner turns one on.
AI_LANES=ai.small
OLLAMA_MODEL=qwen2.5:3b

# Optional: nightly backups to OCI Object Storage (needs the OCI CLI configured).
OCI_BUCKET=
# Optional: where backups are kept on the VM (default /var/backups/luggagetracker).
BACKUP_DIR=
# Optional: back up another database than DATABASE_URL (e.g. the localdb profile's).
BACKUP_DATABASE_URL=

# Optional profile "localdb": the local Postgres password.
POSTGRES_PASSWORD=
# Optional profile "tunnel": Cloudflare Zero Trust → Networks → Tunnels → token.
CLOUDFLARE_TUNNEL_TOKEN=
